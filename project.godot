[layer_names]

3d_physics/layer_1="ship"
3d_physics/layer_2="character"
3d_physics/layer_3="debris"
3d_physics/layer_4="environment"

[physics]

3d/default_gravity=0.0
common/physics_ticks_per_second=60

[rendering]

; Required for Android export, and wanted anyway: the 4096x2048 Earth albedo
; is 32 MB of VRAM uncompressed.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
; Android runs gl_compatibility, and that is a DELIBERATE choice, not a
; fallback. Godot refuses to export forward_plus to Android at all, which
; leaves Forward Mobile or Compatibility — and Forward Mobile is the broken
; one here: it cannot read the depth buffer that
; assets/shaders/atmosphere_common.gdshaderinc clamps its march against, so
; every ray traverses the full 50 m shell instead of stopping at terrain.
; Earth's relief fills 80% of that shell, so the planet washes out under
; doubled in-scatter. Compatibility reads depth correctly and renders close
; to Forward+ (slightly oversaturated). Verified on the desktop, no phone
; required: tests/capture_renderer_probe.gd, one shot per renderer.
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

planet_sun_direction={
"type": "vec3",
"value": Vector3(0, 0, 1)
}
