; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cascade"
config/description="Newtonian debris salvage in near-Earth orbit."
run/main_scene="res://scenes/game_world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]


SimClock="*res://scripts/autoload/SimClock.gd"
GameState="*res://scripts/autoload/GameState.gd"
ContractManager="*res://scripts/autoload/ContractManager.gd"
OriginShift="*res://scripts/autoload/OriginShift.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; Phones: scale the 1600x900 UI to the device screen rather than rendering a
; 14 px HUD on a 1080p panel, and lock landscape — the flight HUD is wide.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

